{
  "name": "@hunter/platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @hunter/flight-api db:generate",
    "db:migrate": "pnpm --filter @hunter/flight-api db:migrate",
    "db:seed": "pnpm --filter @hunter/flight-api db:seed",
    "setup": "node scripts/setup.mjs",
    "typecheck": "turbo typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "clean": "turbo clean && node scripts/clean.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "execa": "9.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
