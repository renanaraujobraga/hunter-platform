NODE_ENV="development"
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=3333
CORS_ORIGINS="http://localhost:3000"

# MVP local mode: allows the current Premium V6 dashboard to work before login UI is wired.
# Set to false when the frontend starts sending Bearer tokens everywhere.
DEMO_MODE="true"

# Automatic Hunter scans.
HUNTER_SCHEDULER_ENABLED="true"
HUNTER_SCAN_INTERVAL_MINUTES="15"
